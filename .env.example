# Copie este arquivo para .env e preencha com o token da API da CML
CML_TOKEN=seu_token_aqui

# PostgreSQL local. Não envie o .env para o Git.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hackathon2026
DB_USER=postgres
DB_PASSWORD=preencha_a_senha_local

# Responsáveis habilitados para revisão declarada de vigência, separados por vírgula.
# Vazio: registros ficam pendentes até definição do fluxo institucional.
GOVERNANCA_REVISORES=

# Hospedagem: conexão PostgreSQL TLS (somente no servidor).
# DATABASE_URL=postgresql://usuario:senha@servidor/banco?sslmode=require
# API_MODO=documental
# CORS_ORIGINS=https://rafapiasentin.github.io
